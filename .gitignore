# ============================================
# BACKEND
# ============================================

# Dependências do backend
backend/node_modules/
backend/dist/

# Arquivos de ambiente do backend
backend/.env
backend/.env.local
backend/.env.*.local

# Logs do backend
backend/logs/
backend/*.log
backend/npm-debug.log*

# Arquivos do TypeScript (backend)
backend/*.tsbuildinfo

# ============================================
# FRONTEND (quando criar)
# ============================================

# Dependências do frontend
frontend/node_modules/
frontend/dist/
frontend/build/

# Arquivos de ambiente do frontend
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs do frontend
frontend/logs/
frontend/*.log
frontend/npm-debug.log*

# Arquivos do frontend (React/Vite)
frontend/.vite/
frontend/.cache/

